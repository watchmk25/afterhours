# Server-only live matching and trusted local diagnostics. Never use a NEXT_PUBLIC_ prefix.
QLOO_API_KEY=

# Optional server-only event planning. GOOGLE_API_KEY is never used by this app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Server-only shared demo controls. Use ONE account-owned Upstash Redis Free DB.
# Never add a payment method/paid upgrade for this setup; keep eviction disabled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Independent random secret, at least 32 characters. Never use NEXT_PUBLIC_.
AFTERHOURS_USAGE_SECRET=
# Default off. Enable only after shared controls are configured and verified.
# Set false (or unset) and redeploy/restart to pause all public live actions.
AFTERHOURS_LIVE_ENABLED=false
